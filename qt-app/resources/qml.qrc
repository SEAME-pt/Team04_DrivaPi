<RCC>
    <qresource prefix="/">
        <!-- QML -->
        <file>qml/main.qml</file>
        
        <!-- Components -->
        <file>qml/components/battery_indicator.qml</file>
        <file>qml/components/energy_display.qml</file>
        <file>qml/components/gear_selector.qml</file>
        <file>qml/components/speed_display.qml</file>
        
        <!-- Screens (Phase 1) -->
        <file>qml/screens/ClusterScreen.qml</file>
        <file>qml/screens/NavigationScreen.qml</file>
        <file>qml/screens/MediaScreen.qml</file>
        <file>qml/screens/DiagnosticsScreen.qml</file>
        <file>qml/screens/SettingsScreen.qml</file>
        
        <!-- Theme (Phase 1) -->
        <file>qml/theme/AppTheme.qml</file>
        <file>qml/theme/qmldir</file>

        <!-- Background Assets -->
        <file>assets/backgrounds/cluster-base.svg</file>
        <file>assets/backgrounds/default.svg</file>
        <file>assets/backgrounds/vector-1.svg</file>
        <file>assets/backgrounds/vector-2.svg</file>
        <file>assets/Model 3.png</file>

        <!-- Cluster Icons -->
        <file>icons/cluster/speedometer.svg</file>
        <file>icons/cluster/car.svg</file>
        <file>icons/cluster/car-alt.svg</file>
        <file>icons/cluster/model3.svg</file>

        <!-- Status Icons -->
        <file>icons/status/low-beam-headlights.svg</file>
        <file>icons/status/low-beam-headlights-white.svg</file>
        <file>icons/status/lights.svg</file>
        <file>icons/status/lights-white.svg</file>
        <file>icons/status/parking-lights.svg</file>
        <file>icons/status/parking-lights-white.svg</file>
        <file>icons/status/rear-fog-lights.svg</file>
        <file>icons/status/rear-fog-lights-red.svg</file>
        <file>icons/status/indicator-1.svg</file>
        <file>icons/status/indicator-1-grey.svg</file>
        <file>icons/status/indicator-2.svg</file>
        <file>icons/status/indicator-2-red.svg</file>
        <file>icons/status/indicator-3.svg</file>
        <file>icons/status/indicator-3-red.svg</file>
        <file>icons/status/warning-icon.svg</file>
        <file>icons/status/warning-icon-red.svg</file>

        <!-- Mode Icons -->
        <file>icons/common/nav-mode.svg</file>
        <file>icons/common/nav-mode-active.svg</file>
        <file>icons/common/steering-mode.svg</file>
        <file>icons/common/steering-mode-active.svg</file>
        <file>icons/common/media-mode.svg</file>
        <file>icons/common/media-mode-active.svg</file>
    </qresource>
</RCC>
