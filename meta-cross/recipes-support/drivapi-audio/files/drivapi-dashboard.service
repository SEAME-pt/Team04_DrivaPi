[Unit]
Description=DrivaPi Dashboard (Qt)
After=pipewire-system.service pipewire-pulse-system.service wireplumber-system.service graphical.target
Requires=pipewire-system.service pipewire-pulse-system.service
Wants=wireplumber-system.service graphical.target

[Service]
Type=simple

# Runtime first (important)
Environment=XDG_RUNTIME_DIR=/run/pipewire
Environment=WAYLAND_DISPLAY=wayland-0
Environment=QT_QPA_PLATFORM=wayland-egl
Environment=PULSE_SERVER=unix:/run/pipewire/pulse/native

# Optional: provide the "classic" pulseaudio socket path too (helps some clients)
ExecStartPre=/bin/sh -c 'mkdir -p /run/user/0/pulse && ln -sf /run/pipewire/pulse/native /run/user/0/pulse/native || true'

ExecStart=/usr/bin/myqtapp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
