[Unit]
Description=DrivaPi Dashboard (Qt)
After=graphical.target pipewire-system.service
Wants=graphical.target pipewire-system.service pipewire-pulse-system.service wireplumber-system.service

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-0
Environment=QT_QPA_PLATFORM=wayland-egl
Environment=PULSE_SERVER=unix:/run/pipewire/pulse/native

# Wait up to ~10s for pulse socket to exist (prevents "connection refused" on boot)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -S /run/pipewire/pulse/native ] && exit 0; sleep 0.2; done; echo "Pulse socket missing"; exit 1'

ExecStart=/usr/bin/myqtapp
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
