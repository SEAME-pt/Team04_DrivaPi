# ---------------------------------------------------------------------------
# QGuiApplication constructor — Qt-internal platform initialisation.
# The user creates QGuiApplication in main.cpp, but the allocations here
# happen INSIDE Qt's constructor (platform plugin loading, event dispatcher,
# screen enumeration, input-method setup).  The user has no control over
# these and cannot free them — Qt holds them intentionally for the lifetime
# of the process.  Covers: QGuiApplicationPrivate::init,
# createPlatformIntegration, createEventDispatcher, init_platform,
# QOffscreenIntegration, QFactoryLoader plugin-metadata cache.
# NOT affected: kuksaReader/canReader are allocated AFTER QGuiApplication
# is fully constructed, so their stacks never contain this frame.
# ---------------------------------------------------------------------------
{
   qt_gui_application_init
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:*QGuiApplication*QGuiApplication*
}

