# ---------------------------------------------------------------------------
# Qt QML type registry — QQmlTypePrivate objects
# Every qmlRegisterType / Q_DECLARE_METATYPE call inserts a QQmlTypePrivate
# node into a global QMultiHash.  Qt never removes these entries; the entire
# registry is reachable via a global pointer at exit.  Stacks anchored on:
#   createQQmlType  →  QQmlTypePrivate::QQmlTypePrivate
#   QQmlMetaType::registerType  →  QQmlPrivate::qmlregister
# ---------------------------------------------------------------------------
{
   qt_qml_type_registry_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:*QQmlType*
}
{
   qt_qml_metatype_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:*QQmlMetaType*
}
{
   qt_qml_register_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:*QQmlPrivate*qmlregister*
}

