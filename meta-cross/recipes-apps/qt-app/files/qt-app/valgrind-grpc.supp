# ===========================================================================
# gRPC channelz / metadata std::variant<string_view, string> copy
# Allocation chain: operator new → basic_string::_M_construct (IN libstdc++)
# → std::__detail::__variant::_Uninitialized (frame 3, compiled into myqtapp).
# Using obj:*libstdc++* for frame 2 avoids cross-library fun: matching issues;
# _M_construct in libstdc++ 3.22 does not reliably match via fun: wildcard when
# reached through ... at the suppression start.
# Confirmed: no source file in src/ uses std::variant with grpc_core types.
# ===========================================================================
{
   grpc_metadata_variant_string
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   obj:*vgpreload_memcheck*
   obj:*libstdc++*
   fun:*__variant*_Uninitialized*
   ...
}

# ===========================================================================
# gRPC ChannelArgs::Pointer copy — shared_ptr inside ChannelArgTypeTraits
# When gRPC copies ChannelArgs (subchannel retry, handshake), it copies
# shared_ptr-wrapped objects (StatsPluginGroup, EventEngine, channelz::BaseNode)
# via the VTable copy lambda. The ChannelArgs AVL tree is ref-counted; copies
# made during ExecCtx flush on exit may not be destroyed before heap sampling.
# Both error contexts (StatsPluginGroup and EventEngine) share the same
# ChannelArgs::Set(string_view, Pointer) outermost visible frame.
# Note: fun:*ChannelArgs*Pointer*Pointer* failed in Valgrind 3.22 (repeated
# word "Pointer" in both pattern and string causes VG_string_match issues).
# Anchor on ChannelArgs::Set(string_view, Pointer) instead — unique name,
# no repeated keywords, always present at the top of the 12-frame window.
# Confirmed: no source file calls ChannelArgs::Set(string_view, Pointer).
# ===========================================================================
{
   grpc_channel_args_pointer_copy
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:*ChannelArgs*Set*ChannelArgs*Pointer*
}

# ===========================================================================
# gRPC ChannelArgs AVL tree — AddKey path during subchannel ChannelArgs copy
# AVL::MakeNode is inlined by the compiler so it never appears as a named
# frame; this suppression uses AVL::Add which IS a visible non-inlined frame
# in both ChannelArgs::Pointer copy error contexts.
# Confirmed: no source file uses grpc_core::AVL or ChannelArgs::Set.
# ===========================================================================
{
   grpc_channel_args_avl_node
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:*grpc_core*AVL*Add*
   ...
   fun:*grpc_core*ChannelArgs*Set*
}

# ===========================================================================
# gRPC OldSubchannel — RefCountedString key allocation on subchannel creation
# When OldSubchannel is constructed it calls ChannelArgs::SetObject which
# invokes ChannelArgs::Set, which allocates a RefCountedStringValue key via
# gpr_malloc/RefCountedString::Make. This is a key string (e.g. peer address)
# stored in the subchannel's channelargs. The subchannel is not fully destroyed
# before Valgrind samples the heap when KUKSA is unreachable at exit.
# Stack: vgpreload/malloc → gpr_malloc → RefCountedString::Make →
#        RefCountedStringValue → ChannelArgs::Set(×3) →
#        ChannelArgs::SetObject → OldSubchannel::OldSubchannel →
#        MakeRefCounted<OldSubchannel> → OldSubchannel::Create → Subchannel::Create
# Confirmed: gpr_malloc and RefCountedString are pure gRPC internals.
# ===========================================================================
{
   grpc_refcounted_string_subchannel
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   obj:*vgpreload_memcheck*
   fun:*gpr_malloc*
   fun:*grpc_core*RefCountedString*Make*
   ...
   fun:*grpc_core*OldSubchannel*Create*
   ...
}

# ===========================================================================
# gRPC WorkSerializer — WorkSerializerImpl allocated inside OldSubchannel
# OldSubchannel::OldSubchannel constructs a WorkSerializer which allocates a
# WorkSerializerImpl via MakeOrphanable. The subchannel is not fully destroyed
# before heap sampling when KUKSA is unreachable at exit.
# Stack: vgpreload/operator new → MakeOrphanable<WorkSerializerImpl> →
#        WorkSerializer::WorkSerializer → OldSubchannel::OldSubchannel →
#        MakeRefCounted<OldSubchannel> → OldSubchannel::Create → ...
# MakeOrphanable<WorkSerializerImpl> has a ~300-char demangled return type;
# matching that frame with fun: + obj: proved unreliable in Valgrind 3.22.
# Anchor on the unique substring WorkSerializerImpl — appears only in this
# gRPC allocation path and never in our own source files.
# Confirmed: WorkSerializer and WorkSerializerImpl are pure gRPC internals.
# ===========================================================================
{
   grpc_work_serializer_subchannel
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:*WorkSerializerImpl*
   ...
}

# ===========================================================================
# gRPC OldSubchannel object — MakeRefCounted allocation on subchannel creation
# The OldSubchannel object itself (688 bytes × 2 blocks) is allocated via
# MakeRefCounted when PickFirst load-balancer creates subchannels for each
# KUKSA endpoint address. The subchannel is not fully destroyed before heap
# sampling when KUKSA is unreachable at exit.
# Stack: vgpreload/operator new → MakeRefCounted<OldSubchannel,SubchannelKey>
#        → OldSubchannel::Create → Subchannel::Create →
#        GenericClientChannelFactory::CreateSubchannel → ...
# Confirmed: OldSubchannel and MakeRefCounted are pure gRPC internals.
# ===========================================================================
{
   grpc_old_subchannel_object
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   obj:*vgpreload_memcheck*
   fun:*grpc_core*MakeRefCounted*OldSubchannel*
   fun:*grpc_core*OldSubchannel*Create*
   fun:*grpc_core*Subchannel*Create*
   ...
}

# ===========================================================================
# gRPC OldSubchannel connectivity state — absl::Status on connection failure
# Status is allocated when the subchannel reports a failed connect attempt.
# gRPC does not fully drain ExecCtx before process exit when the channel is
# still retrying. Discriminator: OldSubchannel::SetConnectivityStateLocked is
# deep gRPC internals, never called from our source files.
# ===========================================================================
{
   grpc_subchannel_connectivity_status
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:*absl*Status*Status*
   fun:*grpc_core*OldSubchannel*SetConnectivityStateLocked*
   ...
}

# ===========================================================================
# gRPC PosixEventEngine::RunAfterInternal — reconnect timer closure
# When a subchannel schedules a reconnect, RunAfterInternal stores an
# AnyInvocable<void()> on the heap. If the channel is shut down before the
# timer fires, the closure is abandoned at process exit (well-known gRPC
# issue). Confirmed: PosixEventEngine is not used in any of our source files.
# ===========================================================================
{
   grpc_posix_event_engine_run_after
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:*grpc_event_engine*experimental*PosixEventEngine*RunAfterInternal*
}

# ===========================================================================
# Qt Quick software renderer — lazy scene-graph node bookkeeping
# QQuickWindowPrivate::updateDirtyNode uses QLazilyAllocated to allocate
# per-item scene-graph bookkeeping data on first render pass. When
# QT_QUICK_BACKEND=software is forced, QSGSoftwareRenderLoop does not
# release this data when the window is destroyed on process exit.
# Confirmed: QQuickWindowPrivate is Qt private API, not used in our code.
# ===========================================================================
{
   qtquick_software_renderer_lazy_node
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:*QQuickWindowPrivate*updateDirtyNode*
}

# ===========================================================================
# Qt software renderer — thread pool QRunnable for blend_untransformed_generic
# When QT_QUICK_BACKEND=software is used, QSGSoftwareRenderer dispatches image
# blending work via QThreadPool::start(QRunnable::create(lambda)). The QRunnable
# heap object is "definitely lost" if the thread pool task is still in flight
# when Valgrind samples the heap at process exit (child render process).
# Stack: operator new → QRunnable::create<blend_untransformed_generic lambda> →
#        QThreadPool::start → blend_untransformed_generic → fillRect_normalized →
#        QRasterPaintEngine::drawImage → ... → QSGSoftwareRenderLoop::renderWindow
# Confirmed: blend_untransformed_generic is Qt private API (qdrawhelper.cpp),
# not used in any of our source files.
# ===========================================================================
{
   qt_software_blend_threadpool_runnable
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   fun:*blend_untransformed_generic*
   ...
   fun:*QSGSoftwareRenderLoop*renderWindow*
}


# QHttpNetworkConnectionChannel::init() registers QObject connections via
# QMetaObjectPrivate::connect. The ConnectionData vector (resizeSignalVector)
# is not freed if the HTTP channel is destroyed before Qt's network manager
# cleanup runs. Triggered by gRPC's DNS lookup via Qt's QNetworkAccessManager.
# Discriminator: QHttpNetworkConnectionChannel::init() in stack — not called
# from any of our source files.
# ===========================================================================
{
   qt_http_network_channel_signals
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:*resizeSignalVector*
   fun:*addConnection*
   fun:*QMetaObjectPrivate*connect*
   ...
   fun:*QHttpNetworkConnectionChannel*init*
}

# ===========================================================================
# glibc DNS resolver configuration block — QHostInfoRunnable thread
# getaddrinfo() initialises a per-thread __resolv_conf context on first
# invocation via __resolv_conf_allocate. glibc intentionally keeps this
# allocation alive for thread reuse; it is never freed on thread exit by
# design (POSIX TLS). Triggered when Qt's thread pool resolves the KUKSA
# hostname. Confirmed: getaddrinfo is not called in any of our source files.
# ===========================================================================
{
   glibc_resolv_conf_qhostinfo
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:__resolv_conf_allocate
   ...
   fun:getaddrinfo
   ...
   fun:*QHostInfoRunnable*run*
}

# ===========================================================================
# glibc/ld.so — dynamic linker dependency array on dlopen
# _dl_map_object_deps allocates a 40-byte struct to track library dependency
# load order when a plugin is opened via dlopen (Qt platform/image plugins at
# startup). ld.so owns this allocation and frees it only when the library is
# explicitly dlclose'd; Qt plugins loaded at startup stay open for the process
# lifetime and are unloaded after Valgrind samples the heap on exit.
# Confirmed: dlopen is not called in any of our source files.
# ===========================================================================
{
   ld_dlopen_deps_array
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:_dl_map_object_deps
   ...
   fun:dl_open_worker_begin
   ...
   fun:dlopen*
}

# ===========================================================================
# "still reachable" suppressions
#
# All blocks below are SYSTEM / THIRD-PARTY library global state that is
# kept alive via live pointers until process exit.  None originates in
# application source files.  These suppressions only affect the
# "still reachable" bucket — they cannot hide real (definite/indirect/
# possible) leaks in our code.
# ===========================================================================

# ---------------------------------------------------------------------------
# OpenSSL — libcrypto / libssl global object registry
# OBJ_NAME_add, OPENSSL_LH_insert, CRYPTO_zalloc keep algorithm names and
# cipher objects in a global hash table for the lifetime of the process.
# ---------------------------------------------------------------------------
{
   openssl_libcrypto_global_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*libcrypto*
}
{
   openssl_libssl_global_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*libssl*
}

